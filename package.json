{
  "name": "open-guandan",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --workspace @open-guandan/server",
    "dev:web": "npm run dev --workspace @open-guandan/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start:server": "npm run start --workspace @open-guandan/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
