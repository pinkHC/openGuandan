{
  "name": "@open-guandan/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cargo run",
    "start": "cargo run --release --locked",
    "build": "cargo build --release --locked",
    "typecheck": "cargo check --all-targets --locked",
    "test": "cargo test --all-targets --locked && node --test tests/socketio.test.mjs",
    "fmt": "cargo fmt --all -- --check",
    "clippy": "cargo clippy --locked --all-targets --all-features -- -D warnings"
  },
  "devDependencies": {
    "socket.io-client": "4.8.3"
  }
}
